# Alacritty (modules/alacritty/alacritty.toml) の設定を移行したもの。
# 配色はテーマに任せる。背景の透過 (Alacritty の opacity / blur) は使わない。

# フォント
font-family = PlemolJP Console NF
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 9
# Alacritty の font.offset (x = -1) に相当する設定は Ghostty に無いため移行しない。

# 配色
theme = One Half Dark

# カーソル (Alacritty の shape = Beam / blinking = On)
cursor-style = bar
cursor-style-blink = true

# 余白
window-padding-x = 8
window-padding-y = 8

# macOS の Option キーを Alt として扱う (Alacritty の option_as_alt = "Both")
macos-option-as-alt = true

# 直接バイナリ起動(niri の spawn など)でも single-instance を有効化し、
# 2回目以降のウィンドウ起動を高速化する。
gtk-single-instance = true
