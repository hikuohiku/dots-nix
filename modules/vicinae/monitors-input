#!/usr/bin/env bash
# monitors-input <VCP 0x60 の値>
# ddcutil で共有モニタ 2 台の入力 (VCP 0x60) を切り替える。
# 値は 17 (0x11) = HDMI1 (hikuo-desktop)、27 (0x1b) = USB-C (hikuo-macbook)。
# S2722QC は現在値の読み取りが不安定なため、値を読まずに直接書き込む。
set -euo pipefail

want=$1

# ddcutil の --sn に指定する対象モニタのシリアル番号。`ddcutil detect` で確認できる。
monitors=(
  "FSHR464"
  "7VK4MD3"
)

# モニタごとに ddcutil を並列実行し、1 台でも失敗した場合は 1 を返す。
pids=()
for m in "${monitors[@]}"; do
  ddcutil --sn="$m" --noverify setvcp 60 "$want" &
  pids+=("$!")
done

rc=0
for pid in "${pids[@]}"; do
  wait "$pid" || rc=1
done
exit "$rc"
