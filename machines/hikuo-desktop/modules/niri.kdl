input {
    keyboard {
        xkb {
            layout ""
            model ""
            rules ""
            variant ""
        }
        repeat-delay 250
        repeat-rate 50
        track-layout "global"
        numlock
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.5
    }
    mouse { natural-scroll; }
    // Keychron Nape Pro は udev で trackball 扱いにしているため、このセクションで感度を設定する。
    trackball {
        natural-scroll
        accel-speed -0.8
    }
}
// 右の縦置きサブ。position の y は、メイン(論理 1920x1080)に対して
// 論理 1080x1920 を上下中央へ合わせた値 (1080-1920)/2 = -420。
// 正面のメイン。
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
prefer-no-csd
layout {
    gaps 16
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
    border { off; }
    default-column-width { proportion 0.500000; }
    preset-column-widths {
        proportion 0.333333
        proportion 0.500000
        proportion 0.666667
    }
    center-focused-column "never"
}
hotkey-overlay {
    skip-at-startup
}
cursor {
    xcursor-theme "default"
    xcursor-size 24
}
binds {
    Alt+Print { screenshot-window; }
    Ctrl+Alt+Delete hotkey-overlay-title="niri を終了" { quit; }
    Ctrl+Print { screenshot-screen; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+A hotkey-overlay-title="herdr-gpui を開く" { spawn "niri-focus-or-spawn" "so.pen.herdr-gpui" "herdr-gpui"; }
    Mod+B hotkey-overlay-title="Bluetooth パネルの表示を切り替え" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+BracketLeft hotkey-overlay-title="ウィンドウを左のカラムへ統合 / 分離" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="ウィンドウを右のカラムへ統合 / 分離" { consume-or-expel-window-right; }
    Mod+C { center-column; }
    Mod+Comma { consume-window-into-column; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+Ctrl+F hotkey-overlay-title="フローティングとタイリングを切り替え" { toggle-window-floating; }
    Mod+Ctrl+H hotkey-overlay-title="カラムを左へ移動" { move-column-left; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+J hotkey-overlay-title="カラムを下のワークスペースへ移動" { move-column-to-workspace-down; }
    Mod+Ctrl+K hotkey-overlay-title="カラムを上のワークスペースへ移動" { move-column-to-workspace-up; }
    Mod+Ctrl+L hotkey-overlay-title="カラムを右へ移動" { move-column-right; }
    Mod+Ctrl+Left { move-column-left; }
    "Mod+Ctrl+Page_Down" { move-column-to-workspace-down; }
    "Mod+Ctrl+Page_Up" { move-column-to-workspace-up; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+V hotkey-overlay-title="クリップボード履歴を開く" { spawn "vicinae" "vicinae://launch/clipboard/history?toggle=true"; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Down { focus-window-down; }
    Mod+End { focus-column-last; }
    Mod+D hotkey-overlay-title="Discord を開く" { spawn "niri-focus-or-spawn" "discord" "discord"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+F hotkey-overlay-title="カラムを最大化" { maximize-column; }
    Mod+H hotkey-overlay-title="左のカラムへフォーカス" { focus-column-left; }
    Mod+Home { focus-column-first; }
    Mod+J hotkey-overlay-title="下のワークスペースへ切り替え" { focus-workspace-down; }
    Mod+K hotkey-overlay-title="上のワークスペースへ切り替え" { focus-workspace-up; }
    Mod+L hotkey-overlay-title="右のカラムへフォーカス" { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+N hotkey-overlay-title="フォーカス中のアプリの新規インスタンスを開く" { spawn "niri-spawn-focused-app"; }
    Mod+O hotkey-overlay-title="オーバービューを開く" repeat=false { toggle-overview; }
    "Mod+Page_Down" { focus-workspace-down; }
    "Mod+Page_Up" { focus-workspace-up; }
    Mod+Period { expel-window-from-column; }
    Mod+Q hotkey-overlay-title="フォーカス中のウィンドウを閉じる" { close-window; }
    Mod+R hotkey-overlay-title="カラム幅のプリセットを切り替え" { switch-preset-column-width; }
    Mod+Right { focus-column-right; }
    Mod+S hotkey-overlay-title="Slack を開く" { spawn "niri-focus-or-spawn" "Slack" "slack"; }
    Mod+Shift+3 { screenshot-screen; }
    Mod+Shift+4 hotkey-overlay-title="スクリーンショットを撮る" { screenshot; }
    Mod+Shift+5 { screenshot; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+E { quit; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F hotkey-overlay-title="フルスクリーンの切り替え" { fullscreen-window; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+P { power-off-monitors; }
    "Mod+Shift+Page_Down" { move-workspace-down; }
    "Mod+Shift+Page_Up" { move-workspace-up; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+S hotkey-overlay-title="配信用ディスプレイを切り替え (S2725QC FHD@1)" { spawn "niri-toggle-stream-display"; }
    Mod+Shift+Slash hotkey-overlay-title="重要なホットキーを表示" { show-hotkey-overlay; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+V hotkey-overlay-title="フローティングとタイリングの間でフォーカスを切り替え" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Space hotkey-overlay-title="ランチャーを開く" { spawn "vicinae" "toggle"; }
    Mod+T hotkey-overlay-title="ターミナルを開く" { spawn "niri-focus-or-spawn" "com.mitchellh.ghostty" "ghostty"; }
    Mod+Up { focus-window-up; }
    Mod+V hotkey-overlay-title="Visual Studio Code を開く" { spawn "niri-focus-or-spawn" "code" "code" "--enable-wayland-ime"; }
    Mod+W hotkey-overlay-title="Zen Browser を開く" { spawn "niri-focus-or-spawn" "zen-beta" "zen-beta"; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Print { screenshot; }
    Super+Alt+L hotkey-overlay-title="画面をロック" { spawn "swaylock"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
}
spawn-at-startup "niri-early-wallpaper"
spawn-at-startup "niri-float-extension-windows"
// Bitwarden 自身の自動起動は実行中の版のストアパスを書くため、古い版が消えると壊れる。PATH 経由で起動する。
spawn-at-startup "bitwarden" "--autostart"
spawn-at-startup "codexbar-linux" "--background"
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    default-column-width
}
window-rule {
    match app-id="^Alacritty$"
    draw-border-with-background false
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^zen-beta$"
    draw-border-with-background false
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match app-id="^bitwarden$"
    open-floating true
}
window-rule {
    match app-id="^zen-beta$"
    open-floating true
}
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}
// DMS の colors.kdl が layout のフォーカスリング色を primary で上書きするため、window-rule で控えめな色に固定する。
window-rule {
    focus-ring {
        active-color "#8e8e93"
        inactive-color "#d1d1d6"
    }
}
layer-rule {
    match namespace="^dms:"
    match namespace="^vicinae$"
    exclude namespace="^dms:blurwallpaper"
    background-effect {
        xray false
    }
    popups {
        background-effect {
            xray false
        }
    }
}
blur {
    passes 6
    offset 16.0
    noise 0.0
    saturation 1.4
}
